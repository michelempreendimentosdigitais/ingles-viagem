<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Wh-Questions — Anki da Felipha</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#132244; --navy-deep:#0b1730; --gold:#c9a227; --gold-soft:#e6c35c; --cream:#f6f1e4;
    --green:#4f7a5c; --red:#c56b6b; --blue:#3f6ea5; --orange:#c8823a;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{height:100%;}
  body{
    font-family:'Inter',sans-serif;
    background:
      radial-gradient(circle at 0% 0%, rgba(201,162,39,0.18), transparent 55%),
      radial-gradient(circle at 100% 0%, rgba(201,162,39,0.14), transparent 55%),
      radial-gradient(circle at 100% 100%, rgba(201,162,39,0.10), transparent 55%),
      radial-gradient(circle at 0% 100%, rgba(201,162,39,0.10), transparent 55%),
      linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
    min-height:100vh;
    display:flex;
    justify-content:center;
    padding:env(safe-area-inset-top) 14px env(safe-area-inset-bottom);
    color:var(--cream);
  }
  .app{
    width:100%;
    max-width:430px;
    padding:18px 0 40px;
    display:flex;
    flex-direction:column;
    gap:14px;
  }
  header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
  }
  h1{
    font-family:'Poppins',sans-serif;
    font-weight:800;
    font-size:17px;
    line-height:1.25;
    color:var(--cream);
    letter-spacing:0.2px;
  }
  h1 span{display:block; font-size:11px; font-weight:600; color:var(--gold-soft); letter-spacing:1px; text-transform:uppercase; margin-bottom:2px;}
  .rule-btn{
    flex-shrink:0;
    background:rgba(246,241,228,0.08);
    border:1px solid rgba(201,162,39,0.5);
    color:var(--gold-soft);
    font-family:'Inter',sans-serif;
    font-weight:600;
    font-size:12.5px;
    padding:9px 12px;
    border-radius:12px;
    cursor:pointer;
    white-space:nowrap;
  }
  .rule-btn:active{transform:scale(0.97);}

  .progress-wrap{
    background:rgba(246,241,228,0.08);
    border:1px solid rgba(201,162,39,0.25);
    border-radius:14px;
    padding:12px 14px;
    display:flex;
    flex-direction:column;
    gap:8px;
  }
  .progress-stats{
    display:flex;
    justify-content:space-between;
    font-size:12.5px;
    font-weight:600;
    color:var(--gold-soft);
  }
  .progress-track{
    height:8px;
    background:rgba(246,241,228,0.12);
    border-radius:6px;
    overflow:hidden;
  }
  .progress-fill{
    height:100%;
    background:linear-gradient(90deg, var(--gold), var(--gold-soft));
    border-radius:6px;
    width:0%;
    transition:width .35s ease;
  }

  .stage{ flex:1; display:flex; align-items:stretch; }

  .card{
    background:var(--cream);
    color:var(--navy-deep);
    border-radius:20px;
    box-shadow:0 18px 40px rgba(0,0,0,0.35), 0 2px 0 rgba(255,255,255,0.4) inset;
    width:100%;
    padding:26px 22px 22px;
    display:flex;
    flex-direction:column;
    gap:16px;
    min-height:360px;
  }
  .card-top-label{
    font-size:11px;
    font-weight:700;
    letter-spacing:1.5px;
    text-transform:uppercase;
    color:#8a7550;
    text-align:center;
  }
  .en-sentence{
    font-family:'Poppins',sans-serif;
    font-weight:700;
    font-size:23px;
    line-height:1.35;
    text-align:center;
    padding:10px 4px 4px;
  }
  .reveal-zone{
    flex:1;
    display:flex;
    flex-direction:column;
    justify-content:center;
    gap:14px;
  }
  .reveal-btn{
    align-self:center;
    background:var(--navy);
    color:var(--cream);
    border:none;
    font-family:'Poppins',sans-serif;
    font-weight:700;
    font-size:14.5px;
    padding:14px 30px;
    border-radius:14px;
    cursor:pointer;
    letter-spacing:0.3px;
  }
  .reveal-btn:active{transform:scale(0.97);}

  .answer{ display:none; flex-direction:column; gap:12px; animation:fadeIn .25s ease; }
  .answer.show{ display:flex; }
  @keyframes fadeIn{ from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:translateY(0);} }

  .pt-translation{
    font-size:19px;
    font-weight:600;
    text-align:center;
    line-height:1.4;
    color:var(--navy-deep);
  }
  .tag-row{ display:flex; justify-content:center; }
  .tag{
    background:var(--navy);
    color:var(--gold-soft);
    font-family:'Poppins',sans-serif;
    font-weight:700;
    font-size:11px;
    letter-spacing:0.8px;
    padding:6px 14px;
    border-radius:20px;
    text-transform:uppercase;
  }
  .reason{
    background:rgba(19,34,68,0.06);
    border-left:3px solid var(--gold);
    padding:10px 12px;
    border-radius:8px;
    font-size:13.5px;
    line-height:1.5;
    color:#3a3226;
  }
  .audio-row{ display:flex; justify-content:center; }
  .audio-btn{
    background:transparent;
    border:2px solid var(--navy);
    color:var(--navy);
    width:44px; height:44px;
    border-radius:50%;
    font-size:18px;
    cursor:pointer;
    display:flex; align-items:center; justify-content:center;
  }
  .audio-btn.playing{ background:var(--navy); color:var(--gold-soft); }
  .audio-btn:active{ transform:scale(0.94); }

  .grade-grid{
    display:none;
    grid-template-columns:repeat(4, 1fr);
    gap:8px;
  }
  .grade-grid.show{ display:grid; }
  .grade-btn{
    border:none;
    border-radius:12px;
    padding:10px 4px 9px;
    color:#fff;
    font-family:'Inter',sans-serif;
    cursor:pointer;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:3px;
  }
  .grade-btn:active{ transform:scale(0.96); }
  .grade-btn .lbl{ font-size:12px; font-weight:700; }
  .grade-btn .itv{ font-size:10.5px; opacity:0.9; }
  .grade-again{ background:var(--red); }
  .grade-hard{ background:var(--orange); }
  .grade-good{ background:var(--green); }
  .grade-easy{ background:var(--blue); }

  .done-screen{
    background:var(--cream);
    color:var(--navy-deep);
    border-radius:20px;
    box-shadow:0 18px 40px rgba(0,0,0,0.35);
    width:100%;
    padding:40px 26px;
    text-align:center;
    display:flex;
    flex-direction:column;
    gap:14px;
    align-items:center;
    justify-content:center;
    min-height:360px;
  }
  .done-screen .big{ font-family:'Poppins',sans-serif; font-weight:800; font-size:21px; }
  .done-screen .sub{ font-size:14px; color:#5a5140; line-height:1.5; }
  .restart-link{
    margin-top:10px;
    background:none;
    border:none;
    color:#8a7550;
    font-size:12.5px;
    text-decoration:underline;
    cursor:pointer;
  }

  .modal-overlay{
    display:none;
    position:fixed; inset:0;
    background:rgba(11,23,48,0.72);
    z-index:50;
    align-items:flex-end;
    justify-content:center;
  }
  .modal-overlay.show{ display:flex; }
  .modal{
    background:var(--cream);
    color:var(--navy-deep);
    width:100%;
    max-width:430px;
    max-height:85vh;
    overflow-y:auto;
    border-radius:20px 20px 0 0;
    padding:22px 20px 30px;
  }
  .modal h2{
    font-family:'Poppins',sans-serif;
    font-size:18px;
    font-weight:800;
    margin-bottom:12px;
    color:var(--navy-deep);
  }
  .modal h3{
    font-family:'Poppins',sans-serif;
    font-size:14px;
    font-weight:700;
    margin:16px 0 6px;
    color:#5a4a20;
  }
  .modal p, .modal li{ font-size:13.5px; line-height:1.65; color:#3a3226; }
  .modal ul{ padding-left:18px; margin:6px 0; }
  .modal .close-btn{
    display:block;
    margin:20px auto 0;
    background:var(--navy);
    color:var(--cream);
    border:none;
    padding:11px 26px;
    border-radius:12px;
    font-weight:700;
    font-family:'Inter',sans-serif;
    cursor:pointer;
  }
  .modal .ex{
    background:rgba(19,34,68,0.06);
    border-radius:8px;
    padding:8px 10px;
    margin:4px 0;
    font-size:13px;
  }
</style>
</head>
<body>
<div class="app">

  <header>
    <h1><span>Curso de Felipha</span>Wh-Questions: What, Where, When, Who, How, Why</h1>
    <button class="rule-btn" id="ruleBtn">📖 Regra</button>
  </header>

  <div class="progress-wrap">
    <div class="progress-stats">
      <span id="todayStat">Hoje: 0 / 0</span>
      <span id="masteredStat">⭐ 0/0 dominados</span>
    </div>
    <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
  </div>

  <div class="stage" id="stage"></div>

</div>

<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <h2>📖 Wh-Questions: guia completo para Felipha</h2>
    <p>Felipha, este banco de frases cobre as principais <b>Wh-words</b> do inglês — <b>What, Where, When, Who, How, Why</b> e o composto <b>What time</b> — nos contextos em que elas realmente aparecem na fala do dia a dia.</p>

    <h3>Estrutura geral</h3>
    <p><b>Wh-word + auxiliar (do/does/did/is/are/was/were/can...) + sujeito + verbo principal + (complemento)?</b></p>
    <div class="ex">Where <b>do</b> you live?</div>
    <div class="ex">What time <b>does</b> the movie start?</div>
    <div class="ex">Why <b>are</b> you tired?</div>

    <h3>Exceção importante: pergunta sobre o sujeito</h3>
    <p>Quando o próprio Wh-word É o sujeito da frase (geralmente com "who"), <b>não existe auxiliar</b> — a ordem fica igual à de uma afirmação.</p>
    <div class="ex">Who broke the window? <span style="opacity:.7">(não: Who did break the window)</span></div>

    <h3>Cada Wh-word, resumido</h3>
    <ul>
      <li><b>What</b> — coisas, ações, objetos ("What do you do?")</li>
      <li><b>Where</b> — lugar ("Where do you live?")</li>
      <li><b>When</b> — tempo ("When does it start?")</li>
      <li><b>Who</b> — pessoa ("Who is that?")</li>
      <li><b>How</b> — modo, estado, duração ("How do you feel?", "How long...?")</li>
      <li><b>Why</b> — motivo ("Why are you late?")</li>
      <li><b>What time</b> — horário exato ("What time does it start?")</li>
    </ul>

    <h3>Bônus: preposições soltas (stranded prepositions)</h3>
    <p>Dentro de qualquer uma dessas categorias você vai encontrar perguntas onde a preposição do verbo (for, to, about, from, with...) vai para o <b>final</b> da frase em vez de ficar antes do Wh-word — assim como fazemos naturalmente na fala.</p>
    <div class="ex">Who are you waiting <b>for</b>? <span style="opacity:.7">(não: For whom are you waiting?)</span></div>
    <p>Regra prática, Felipha: a preposição "pertence" ao verbo (wait <b>for</b>, look <b>for</b>, talk <b>to</b>, go <b>with</b>) e viaja com ele — quase sempre para o final da pergunta no inglês falado.</p>

    <h3>🧠 Como usar esse app</h3>
    <p>Você vê a frase em inglês e tenta entender/traduzir mentalmente antes de revelar. Ao revelar, avalie sua honestidade: <b>Errei</b> (não entendi), <b>Difícil</b> (entendi com esforço), <b>Bom</b> (entendi bem) ou <b>Fácil</b> (instantâneo). O app usa repetição espaçada real (algoritmo SM-2): cards que você domina bem voltam cada vez mais espaçados; os que você erra voltam logo. Seu progresso fica salvo automaticamente no navegador, Felipha — pode fechar e voltar quando quiser.</p>

    <button class="close-btn" id="closeModal">Entendi</button>
  </div>
</div>

<script>
const KEY_STATE = 'grammarcard_whquestions_felipha_v1';

const data = [
  {id:1, en:"What do you do for a living?", pt:"O que você faz da vida?", tagLabel:"WHAT", reason:"Pergunta clássica sobre profissão: What + auxiliar (do) + sujeito + verbo principal (do). Estrutura padrão para perguntas com verbos que não sejam \"be\"."},
  {id:2, en:"What are you looking for?", pt:"O que você está procurando?", tagLabel:"WHAT", reason:"\"look for\" é um phrasal verb inseparável; a preposição \"for\" acompanha \"look\" até o fim da pergunta — Felipha, esse é um caso de preposição solta."},
  {id:3, en:"What are you thinking about?", pt:"No que você está pensando?", tagLabel:"WHAT", reason:"\"think about\" funciona igual: a preposição fica presa ao verbo e vai para o fim, mesmo com \"what\" abrindo a frase."},
  {id:4, en:"What did she say?", pt:"O que ela disse?", tagLabel:"WHAT", reason:"\"What\" pergunta sobre o objeto direto da fala; o auxiliar \"did\" aparece porque o verbo principal \"say\" está no passado simples."},
  {id:5, en:"What is this used for?", pt:"Para que isso é usado?", tagLabel:"WHAT", reason:"Voz passiva com preposição solta: \"used for something\" vira \"What... for?\" — comum quando você pergunta a função de algo."},
  {id:6, en:"Where do you live?", pt:"Onde você mora?", tagLabel:"WHERE", reason:"Pergunta de localização básica: Where + auxiliar (do) + sujeito + verbo no infinitivo sem \"to\"."},
  {id:7, en:"Where are you from?", pt:"De onde você é?", tagLabel:"WHERE", reason:"\"from\" é a preposição de origem e fica solta no final — Felipha, essa é uma das perguntas mais usadas em viagens."},
  {id:8, en:"Where did you put my keys?", pt:"Onde você colocou minhas chaves?", tagLabel:"WHERE", reason:"Verbo no passado (put) exige o auxiliar \"did\"; \"where\" pergunta sobre o lugar do objeto direto."},
  {id:9, en:"Where are we going?", pt:"Para onde nós estamos indo?", tagLabel:"WHERE", reason:"Presente contínuo com \"be\" como auxiliar: Where + are + we + going, perguntando sobre destino próximo."},
  {id:10, en:"When does the flight leave?", pt:"Quando o voo sai?", tagLabel:"WHEN", reason:"Sujeito na 3ª pessoa do singular (the flight) exige \"does\" como auxiliar no presente simples."},
  {id:11, en:"When did you arrive?", pt:"Quando você chegou?", tagLabel:"WHEN", reason:"\"When\" pergunta sobre o momento da ação; \"did\" sinaliza passado simples do verbo \"arrive\"."},
  {id:12, en:"When is your birthday?", pt:"Quando é o seu aniversário?", tagLabel:"WHEN", reason:"Com o verbo \"be\", não existe auxiliar extra: When + is + sujeito, direto ao ponto."},
  {id:13, en:"When can we meet?", pt:"Quando a gente pode se encontrar?", tagLabel:"WHEN", reason:"O modal \"can\" já funciona como o auxiliar da pergunta — não se usa \"do\" junto com modais."},
  {id:14, en:"Who is that guy?", pt:"Quem é aquele cara?", tagLabel:"WHO", reason:"\"Who\" pergunta sobre identidade; com \"be\", a ordem é Who + is + sujeito, sem auxiliar extra."},
  {id:15, en:"Who did you go with?", pt:"Com quem você foi?", tagLabel:"WHO", reason:"\"go with someone\" — a preposição de companhia \"with\" fica solta no final da pergunta."},
  {id:16, en:"Who broke the window?", pt:"Quem quebrou a janela?", tagLabel:"WHO", reason:"Felipha, aqui \"who\" É o sujeito da frase — por isso não tem auxiliar \"did\": a ordem fica igual à de uma afirmação, sem inverter."},
  {id:17, en:"Who are you waiting for?", pt:"Por quem você está esperando?", tagLabel:"WHO", reason:"\"wait for someone\" — \"for\" acompanha o verbo até o final, padrão de preposição solta com \"who\"."},
  {id:18, en:"How do you feel?", pt:"Como você está se sentindo?", tagLabel:"HOW", reason:"\"How\" pergunta sobre estado ou sensação; auxiliar \"do\" porque o verbo principal é \"feel\", não \"be\"."},
  {id:19, en:"How was your trip?", pt:"Como foi a sua viagem?", tagLabel:"HOW", reason:"Com \"be\" no passado (was), a pergunta não precisa de auxiliar extra: How + was + sujeito."},
  {id:20, en:"How long have you lived here?", pt:"Há quanto tempo você mora aqui?", tagLabel:"HOW", reason:"\"How long\" pergunta sobre duração; o present perfect (\"have lived\") indica uma ação que começou no passado e continua relevante."},
  {id:21, en:"How did you get here?", pt:"Como você chegou aqui?", tagLabel:"HOW", reason:"Passado simples exige \"did\"; \"how\" pergunta sobre o método ou meio usado para chegar."},
  {id:22, en:"Why are you so tired?", pt:"Por que você está tão cansado?", tagLabel:"WHY", reason:"\"Why\" pergunta pelo motivo; com \"be\", a ordem é Why + are + sujeito + adjetivo."},
  {id:23, en:"Why did you leave early?", pt:"Por que você saiu cedo?", tagLabel:"WHY", reason:"Auxiliar \"did\" no passado simples; \"why\" busca a razão da ação de sair."},
  {id:24, en:"Why is he upset?", pt:"Por que ele está chateado?", tagLabel:"WHY", reason:"Felipha, perguntas com \"why\" sempre pedem uma razão — a resposta normalmente começa com \"because\"."},
  {id:25, en:"What time do you usually wake up?", pt:"Que horas você costuma acordar?", tagLabel:"WHAT TIME", reason:"\"What time\" é um Wh-word composto (dois elementos), mas a ordem continua igual: Wh-word + auxiliar + sujeito + verbo."},
  {id:26, en:"What time does the movie start?", pt:"Que horas o filme começa?", tagLabel:"WHAT TIME", reason:"Sujeito na 3ª pessoa (the movie) pede \"does\"; \"what time\" pergunta pelo horário exato do evento."},
  {id:27, en:"What time are we meeting?", pt:"Que horas a gente vai se encontrar?", tagLabel:"WHAT TIME", reason:"Presente contínuo com valor de futuro — comum para perguntar sobre horários já combinados."}
];

// ---------- Persistence ----------
function todayDay(){ return Math.floor(Date.now()/86400000); }

function loadState(){
  try{
    const raw = localStorage.getItem(KEY_STATE);
    if(raw) return JSON.parse(raw);
  }catch(e){}
  const fresh = {};
  data.forEach(c => fresh[c.id] = {reps:0, ease:2.5, interval:0, due:todayDay()});
  return fresh;
}
function saveState(){ localStorage.setItem(KEY_STATE, JSON.stringify(cardStates)); }

let cardStates = loadState();
data.forEach(c => { if(!cardStates[c.id]) cardStates[c.id] = {reps:0, ease:2.5, interval:0, due:todayDay()}; });

// ---------- SM-2 ----------
function previewIntervals(card){
  const hardInt = card.reps===0 ? 1 : Math.max(1, Math.round(card.interval * 1.2));
  let goodInt;
  if(card.reps===0) goodInt = 1;
  else if(card.reps===1) goodInt = 6;
  else goodInt = Math.max(1, Math.round(card.interval * card.ease));
  const easyInt = Math.max(goodInt+1, Math.round(goodInt * card.ease * 1.3));
  return {again:0, hard:hardInt, good:goodInt, easy:easyInt};
}

// ---------- Session ----------
let queue = [];
let initialLen = 0;
const completedIds = new Set();
const today = todayDay();

function buildQueue(){
  queue = data.filter(c => cardStates[c.id].due <= today);
  // shuffle
  for(let i = queue.length - 1; i > 0; i--){
    const j = Math.floor(Math.random() * (i+1));
    [queue[i], queue[j]] = [queue[j], queue[i]];
  }
  initialLen = queue.length;
}
buildQueue();

let currentCard = null;
let currentPreview = null;

const stage = document.getElementById('stage');
const todayStat = document.getElementById('todayStat');
const masteredStat = document.getElementById('masteredStat');
const progressFill = document.getElementById('progressFill');

function updateStats(){
  todayStat.textContent = `Hoje: ${completedIds.size} / ${initialLen}`;
  const masteredCount = data.filter(c => cardStates[c.id].interval >= 16).length;
  masteredStat.textContent = `⭐ ${masteredCount}/${data.length} dominados`;
  const pct = initialLen === 0 ? 100 : Math.min(100, (completedIds.size / initialLen) * 100);
  progressFill.style.width = pct + '%';
}

function nextCard(){
  if(queue.length === 0){
    renderDone();
    return;
  }
  currentCard = queue.shift();
  currentPreview = previewIntervals(cardStates[currentCard.id]);
  renderCard();
}

function renderCard(){
  stage.innerHTML = `
    <div class="card">
      <div class="card-top-label">Traduza mentalmente antes de revelar</div>
      <div class="en-sentence">${escapeHtml(currentCard.en)}</div>
      <div class="reveal-zone" id="revealZone">
        <button class="reveal-btn" id="revealBtn">Ver tradução</button>
        <div class="answer" id="answerBlock">
          <div class="pt-translation">${escapeHtml(currentCard.pt)}</div>
          <div class="tag-row"><span class="tag">${escapeHtml(currentCard.tagLabel)}</span></div>
          <div class="reason">${escapeHtml(currentCard.reason)}</div>
          <div class="audio-row"><button class="audio-btn" id="audioBtn">🔊</button></div>
        </div>
      </div>
      <div class="grade-grid" id="gradeGrid">
        <button class="grade-btn grade-again" data-grade="again"><span class="lbl">Errei</span><span class="itv">agora</span></button>
        <button class="grade-btn grade-hard" data-grade="hard"><span class="lbl">Difícil</span><span class="itv">${currentPreview.hard}d</span></button>
        <button class="grade-btn grade-good" data-grade="good"><span class="lbl">Bom</span><span class="itv">${currentPreview.good}d</span></button>
        <button class="grade-btn grade-easy" data-grade="easy"><span class="lbl">Fácil</span><span class="itv">${currentPreview.easy}d</span></button>
      </div>
    </div>
  `;
  document.getElementById('revealBtn').addEventListener('click', reveal);
  document.querySelectorAll('.grade-btn').forEach(btn => {
    btn.addEventListener('click', () => grade(btn.dataset.grade));
  });
}

function reveal(){
  document.getElementById('revealBtn').style.display = 'none';
  document.getElementById('answerBlock').classList.add('show');
  document.getElementById('gradeGrid').classList.add('show');
  document.getElementById('audioBtn').addEventListener('click', (e) => speak(currentCard.en, e.currentTarget));
}

function grade(g){
  const state = cardStates[currentCard.id];
  if(g === 'again'){
    state.reps = 0;
    state.interval = 0;
    state.ease = Math.max(1.3, +(state.ease - 0.2).toFixed(2));
    state.due = today;
    playTone('again');
    const insertPos = Math.min(queue.length, 3);
    queue.splice(insertPos, 0, currentCard);
  } else {
    const assigned = currentPreview[g];
    if(g === 'hard') state.ease = Math.max(1.3, +(state.ease - 0.15).toFixed(2));
    if(g === 'easy') state.ease = +(state.ease + 0.15).toFixed(2);
    state.reps += 1;
    state.interval = assigned;
    state.due = today + assigned;
    completedIds.add(currentCard.id);
    playTone(g === 'easy' ? 'easy' : 'good');
  }
  saveState();
  updateStats();
  nextCard();
}

function renderDone(){
  updateStats();
  const upcoming = data
    .map(c => cardStates[c.id].due)
    .filter(d => d > today);
  let nextText;
  if(upcoming.length === 0){
    nextText = 'Nenhuma revisão pendente no momento.';
  } else {
    const minDue = Math.min(...upcoming);
    const diff = minDue - today;
    const nextDate = new Date(Date.now() + diff*86400000);
    const dateStr = nextDate.toLocaleDateString('pt-BR', {day:'2-digit', month:'2-digit'});
    nextText = diff === 1
      ? `Próxima revisão: amanhã (${dateStr}).`
      : `Próxima revisão: ${dateStr} (em ${diff} dias).`;
  }
  stage.innerHTML = `
    <div class="done-screen">
      <div class="big">Sessão concluída!</div>
      <div class="sub">Você revisou ${completedIds.size} card(s) hoje.<br>${nextText}</div>
      <button class="restart-link" id="restartBtn">Recomeçar tudo do zero</button>
    </div>
  `;
  document.getElementById('restartBtn').addEventListener('click', restartAll);
}

function restartAll(){
  if(confirm('Isso vai apagar todo o seu progresso salvo neste curso. Tem certeza?')){
    localStorage.removeItem(KEY_STATE);
    cardStates = loadState();
    data.forEach(c => { if(!cardStates[c.id]) cardStates[c.id] = {reps:0, ease:2.5, interval:0, due:todayDay()}; });
    completedIds.clear();
    buildQueue();
    updateStats();
    nextCard();
  }
}

function escapeHtml(str){
  const d = document.createElement('div');
  d.textContent = str;
  return d.innerHTML;
}

// ---------- TTS ----------
let cachedVoices = [];
function refreshVoices(){ cachedVoices = window.speechSynthesis ? window.speechSynthesis.getVoices() : []; }
if('speechSynthesis' in window){ refreshVoices(); window.speechSynthesis.onvoiceschanged = refreshVoices; }
function speak(text, btn){
  if(!('speechSynthesis' in window)) return;
  window.speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(text);
  u.lang = 'en-US';
  u.rate = 0.92;
  const voices = cachedVoices.length ? cachedVoices : window.speechSynthesis.getVoices();
  const v = voices.find(v => v.lang === 'en-US') || voices.find(v => v.lang && v.lang.toLowerCase().startsWith('en'));
  if(v) u.voice = v;
  if(btn) btn.classList.add('playing');
  u.onend = () => { if(btn) btn.classList.remove('playing'); };
  window.speechSynthesis.speak(u);
}

// ---------- Web Audio feedback ----------
let audioCtx = null;
function getCtx(){
  if(!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  return audioCtx;
}
function playTone(kind){
  try{
    const ctx = getCtx();
    const now = ctx.currentTime;
    if(kind === 'again'){
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'square';
      osc.frequency.setValueAtTime(140, now);
      gain.gain.setValueAtTime(0.08, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
      osc.connect(gain); gain.connect(ctx.destination);
      osc.start(now); osc.stop(now + 0.35);
    } else {
      const freqs = kind === 'easy' ? [523.25, 659.25, 783.99, 1046.5] : [523.25, 659.25, 783.99];
      freqs.forEach((f, i) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(f, now + i*0.07);
        gain.gain.setValueAtTime(0.0001, now + i*0.07);
        gain.gain.linearRampToValueAtTime(0.07, now + i*0.07 + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.001, now + i*0.07 + 0.3);
        osc.connect(gain); gain.connect(ctx.destination);
        osc.start(now + i*0.07); osc.stop(now + i*0.07 + 0.3);
      });
    }
  }catch(e){}
}

// ---------- Modal ----------
const modalOverlay = document.getElementById('modalOverlay');
document.getElementById('ruleBtn').addEventListener('click', () => modalOverlay.classList.add('show'));
document.getElementById('closeModal').addEventListener('click', () => modalOverlay.classList.remove('show'));
modalOverlay.addEventListener('click', (e) => { if(e.target === modalOverlay) modalOverlay.classList.remove('show'); });

// ---------- Init ----------
updateStats();
nextCard();
</script>
