/* ---------- SOUND ---------- */
let audioCtx = null;
function getAudioCtx(){ if(!audioCtx){ audioCtx = new (window.AudioContext||window.webkitAudioContext)(); } return audioCtx; }
function playTone(freqs, type, dur){
  try{
    const ctx = getAudioCtx();
    freqs.forEach((f,i)=>{
      const o = ctx.createOscillator(), g = ctx.createGain();
      o.type = type; o.frequency.value = f; o.connect(g); g.connect(ctx.destination);
      const t0 = ctx.currentTime + i*dur;
      g.gain.setValueAtTime(0.0001, t0); g.gain.exponentialRampToValueAtTime(0.25, t0+0.02); g.gain.exponentialRampToValueAtTime(0.0001, t0+dur);
      o.start(t0); o.stop(t0+dur+0.02);
    });
  }catch(e){}
}
function playSuccessSound(){ playTone([523.25,659.25,783.99],'sine',0.11); }
function playErrorSound(){ playTone([220,170],'square',0.14); }
function shuffle(arr){ const a = arr.slice(); for(let i=a.length-1;i>0;i--){ const j = Math.floor(Math.random()*(i+1)); [a[i],a[j]] = [a[j],a[i]]; } return a; }

/* ---------- MATCH GAME ---------- */
const gamePairs = [
  {en:"Passport", pt:"Passaporte"},{en:"Excuse me", pt:"Com licença"},{en:"Thank you so much!", pt:"Muito obrigado!"},
  {en:"Where is the bathroom?", pt:"Onde fica o banheiro?"},{en:"This is my wife.", pt:"Esta é minha esposa."},
  {en:"How are you doing?", pt:"Como você está indo?"},{en:"Nice to meet you.", pt:"Prazer em conhecer você."},{en:"I'm from Brazil.", pt:"Eu sou do Brasil."}
];
let matchLeftSel = null, matchRightSel = null, matchedCount = 0;
function buildGame(){
  const leftCol = document.getElementById('matchLeft'), rightCol = document.getElementById('matchRight');
  leftCol.innerHTML = ''; rightCol.innerHTML = ''; matchedCount = 0;
  document.getElementById('gameWin').classList.remove('show'); document.getElementById('matchLines').innerHTML = '';
  gamePairs.forEach((pair, idx)=>{
    const l = document.createElement('div'); l.className = 'match-item'; l.textContent = pair.en; l.dataset.pid = idx;
    l.onclick = ()=>selectMatchItem(l, 'left'); leftCol.appendChild(l);
  });
  shuffle(gamePairs.map((p,idx)=>({pt:p.pt, pid:idx}))).forEach(item=>{
    const r = document.createElement('div'); r.className = 'match-item'; r.textContent = item.pt; r.dataset.pid = item.pid;
    r.onclick = ()=>selectMatchItem(r, 'right'); rightCol.appendChild(r);
  });
  resizeMatchSvg();
}
function resizeMatchSvg(){
  const box = document.getElementById('matchGame'), svg = document.getElementById('matchLines');
  svg.setAttribute('width', box.clientWidth); svg.setAttribute('height', box.clientHeight);
}
function selectMatchItem(el, side){
  if(el.classList.contains('correct')) return;
  if(side === 'left'){ if(matchLeftSel) matchLeftSel.classList.remove('selected'); matchLeftSel = el; el.classList.add('selected'); }
  else { if(matchRightSel) matchRightSel.classList.remove('selected'); matchRightSel = el; el.classList.add('selected'); }
  if(matchLeftSel && matchRightSel){ setTimeout(evaluateMatch, 80); }
}
function evaluateMatch(){
  if(!matchLeftSel || !matchRightSel) return;
  const isMatch = matchLeftSel.dataset.pid === matchRightSel.dataset.pid;
  const l = matchLeftSel, r = matchRightSel;
  if(isMatch){
    l.classList.remove('selected'); r.classList.remove('selected'); l.classList.add('correct'); r.classList.add('correct');
    drawMatchLine(l, r); playSuccessSound(); spawnConfettiAt(r); matchedCount++;
    if(matchedCount === gamePairs.length){ setTimeout(()=>{ document.getElementById('gameWin').classList.add('show'); spawnConfettiAt(document.getElementById('matchGame'), 30); }, 200); }
  } else {
    l.classList.add('wrong'); r.classList.add('wrong'); playErrorSound();
    setTimeout(()=>{ l.classList.remove('wrong','selected'); r.classList.remove('wrong','selected'); }, 500);
  }
  matchLeftSel = null; matchRightSel = null;
}
function drawMatchLine(leftEl, rightEl){
  const box = document.getElementById('matchGame').getBoundingClientRect();
  const lr = leftEl.getBoundingClientRect(), rr = rightEl.getBoundingClientRect();
  const x1 = lr.right - box.left, y1 = lr.top + lr.height/2 - box.top, x2 = rr.left - box.left, y2 = rr.top + rr.height/2 - box.top;
  const svg = document.getElementById('matchLines'), ns = "http://www.w3.org/2000/svg";
  const line = document.createElementNS(ns, 'line');
  line.setAttribute('x1', x1); line.setAttribute('y1', y1); line.setAttribute('x2', x2); line.setAttribute('y2', y2);
  line.setAttribute('stroke', 'var(--green)'); line.setAttribute('stroke-width', '2.5'); line.setAttribute('stroke-linecap', 'round');
  svg.appendChild(line);
}
function spawnConfettiAt(el, count){
  count = count || 14;
  const box = document.getElementById('matchGame').getBoundingClientRect(); const er = el.getBoundingClientRect();
  const cx = er.left + er.width/2 - box.left, cy = er.top - box.top;
  const layer = document.getElementById('confettiLayer'); const colors = ['#c9a227','#e6c35c','#f6f1e4','#4f7a5c'];
  for(let i=0;i<count;i++){
    const piece = document.createElement('div'); piece.className = 'confetti-piece';
    piece.style.left = (cx + (Math.random()*80-40)) + 'px'; piece.style.top = (cy + (Math.random()*10)) + 'px';
    piece.style.background = colors[Math.floor(Math.random()*colors.length)]; piece.style.animationDelay = (Math.random()*0.15) + 's';
    layer.appendChild(piece); setTimeout(()=>piece.remove(), 1100);
  }
}
