<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aula 1 — Comunicação Útil</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#132244; --navy-deep:#0b1730; --navy-soft:#2b3d63;
    --gold:#c9a227; --gold-soft:#e6c35c;
    --cream:#f6f1e4; --ink:#132244;
    --land:#1c3a5e; --land-line:#3a5a86; --green:#4f7a5c; --green-bg:#bfe3c4; --red-bg:#e8b4b4;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--navy-deep);
    background-image:radial-gradient(circle at 15% 10%, rgba(201,162,39,0.08), transparent 40%),radial-gradient(circle at 85% 90%, rgba(201,162,39,0.06), transparent 40%);
    font-family:'Inter',sans-serif;color:var(--cream);padding:0 0 60px;min-height:100vh;}
  .topbar{background:var(--navy);border-bottom:2px dashed var(--gold);padding:28px 20px 22px;text-align:center;position:relative;}
  .topbar::before,.topbar::after{content:"";position:absolute;bottom:-14px;width:28px;height:28px;background:var(--navy-deep);border-radius:50%;}
  .topbar::before{left:-14px;} .topbar::after{right:-14px;}
  .eyebrow{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--gold-soft);margin-bottom:8px;}
  h1{font-family:'Poppins',sans-serif;font-weight:800;font-size:clamp(22px,5vw,32px);margin:0 0 6px;letter-spacing:-0.5px;}
  .subtitle{font-size:13.5px;color:#c7cee0;max-width:520px;margin:0 auto;}
  .wrap{max-width:680px;margin:0 auto;padding:0 18px;}
  .map-slide{margin:26px 0 10px;border-radius:14px;overflow:hidden;border:1.5px solid var(--gold);box-shadow:0 10px 30px rgba(0,0,0,0.4);}
  .map-slide .map-cap{background:var(--navy);padding:10px 16px;font-family:'Poppins',sans-serif;font-size:12.5px;font-weight:700;color:var(--gold-soft);letter-spacing:1px;text-transform:uppercase;text-align:center;}
  .map-frame{width:100%;aspect-ratio:16/9;background:linear-gradient(180deg,#0e1c38,#132a4f);}
  svg.usmap{display:block;width:100%;height:100%;}
  .trail{fill:none;stroke:var(--gold);stroke-width:3;stroke-dasharray:6 7;opacity:0.55;}
  .land{fill:var(--land);stroke:var(--land-line);stroke-width:2;}
  .stop-circle{fill:var(--navy);stroke:var(--gold);stroke-width:2.5;}
  .stop-circle.active{fill:var(--gold);stroke:var(--cream);}
  .stop-circle.done{fill:var(--gold-soft);stroke:var(--gold-soft);}
  .stop-label{font-family:'Inter',sans-serif;font-size:10px;fill:#c7cee0;}
  .stop-label.active{fill:var(--gold-soft);font-weight:700;}
  .traveler{filter:drop-shadow(0 3px 5px rgba(0,0,0,0.5));}
  .pulse{fill:none;stroke:var(--gold-soft);stroke-width:2;opacity:0.8;transform-origin:center;animation:pulse 2s ease-out infinite;}
  @keyframes pulse{0%{r:14;opacity:0.8;}100%{r:32;opacity:0;}}
  .traveler-move{animation:moveTraveler 2.4s ease-in-out forwards;animation-delay:.4s;}
  @keyframes moveTraveler{0%{transform:translate(0,0);}100%{transform:translate(var(--dx),var(--dy));}}
  .map-note{font-size:12px;color:#a9b3cc;text-align:center;margin:8px 0 4px;}
  .map-note b{color:var(--gold-soft);}
  .mode-bar{display:flex;align-items:center;justify-content:center;gap:12px;margin:22px 0 8px;font-size:13px;color:#c7cee0;}
  .switch{width:44px;height:24px;background:var(--navy-soft);border-radius:20px;position:relative;cursor:pointer;border:1px solid var(--gold);flex-shrink:0;}
  .switch .knob{position:absolute;top:2px;left:2px;width:18px;height:18px;background:var(--gold-soft);border-radius:50%;transition:transform .2s ease;}
  .switch.on .knob{transform:translateX(20px);}
  .section-head{margin:34px 0 14px;display:flex;align-items:baseline;gap:10px;}
  .section-head .tag{font-family:'Poppins',sans-serif;font-weight:700;font-size:12px;background:var(--gold);color:var(--navy-deep);padding:3px 9px;border-radius:4px;letter-spacing:1px;}
  .section-head h2{font-family:'Poppins',sans-serif;font-size:17px;margin:0;color:var(--cream);}
  .section-note{font-size:12.5px;color:#a9b3cc;margin:-6px 0 14px;line-height:1.5;}
  .rescue{background:linear-gradient(135deg,var(--navy) 0%, #1c2f57 100%);border:1.5px solid var(--gold);border-radius:14px;padding:18px 18px 6px;margin-top:8px;box-shadow:0 8px 24px rgba(0,0,0,0.35);}
  .rescue-title{font-family:'Poppins',sans-serif;font-weight:700;font-size:14px;color:var(--gold-soft);display:flex;align-items:center;gap:8px;margin-bottom:4px;}
  .rescue-sub{font-size:12px;color:#b9c2da;margin-bottom:12px;}
  .ticket{background:var(--cream);color:var(--ink);border-radius:12px;margin-bottom:14px;display:flex;position:relative;overflow:hidden;box-shadow:0 4px 14px rgba(0,0,0,0.25);}
  .ticket-main{flex:1;padding:14px 16px;min-width:0;}
  .ticket-stub{width:64px;flex-shrink:0;background:var(--navy);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;position:relative;cursor:pointer;border:none;}
  .ticket-stub::before{content:"";position:absolute;top:0;bottom:0;left:0;border-left:2px dashed var(--navy-deep);opacity:0.5;}
  .ticket-stub .play-ico{width:0;height:0;border-top:8px solid transparent;border-bottom:8px solid transparent;border-left:12px solid var(--gold-soft);}
  .ticket-stub .play-label{font-size:9px;color:var(--gold-soft);letter-spacing:0.5px;font-weight:600;}
  .ticket-stub.playing{background:var(--gold);}
  .ticket-stub.playing .play-ico{border-left-color:var(--navy);}
  .ticket-stub.playing .play-label{color:var(--navy);}
  .en{font-family:'Poppins',sans-serif;font-weight:700;font-size:16px;line-height:1.3;margin-bottom:3px;}
  .phon{font-size:12.5px;color:#6b5b2a;font-style:italic;margin-bottom:6px;}
  .pt{font-size:13px;color:var(--navy-soft);border-top:1px dashed #cfc4a4;padding-top:6px;margin-top:2px;}
  .pt.hidden{opacity:0;max-height:0;overflow:hidden;border-top:none;padding-top:0;margin-top:0;}
  .tap-hint{font-size:11px;color:#8a7d55;margin-top:4px;cursor:pointer;display:inline-block;}
  .vocab-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:6px;}
  .vocab-card{background:var(--cream);border-radius:12px;padding:14px 12px 12px;text-align:center;position:relative;box-shadow:0 4px 14px rgba(0,0,0,0.25);cursor:pointer;}
  .vocab-icon{width:42px;height:42px;margin:0 auto 6px;}
  .vocab-en{font-family:'Poppins',sans-serif;font-weight:700;font-size:14px;color:var(--ink);margin-bottom:2px;}
  .vocab-phon{font-size:10.5px;font-style:italic;color:#6b5b2a;margin-bottom:5px;}
  .vocab-pt{font-size:11.5px;color:var(--navy-soft);border-top:1px dashed #cfc4a4;padding-top:5px;}
  .vocab-play{position:absolute;top:8px;right:8px;display:flex;align-items:center;gap:3px;background:var(--navy);border-radius:11px;padding:3px 7px 3px 6px;}
  .vocab-play .p{width:0;height:0;border-top:5px solid transparent;border-bottom:5px solid transparent;border-left:7px solid var(--gold-soft);}
  .vocab-play .lbl{font-size:8.5px;color:var(--gold-soft);font-weight:700;}
  .vocab-play.playing{background:var(--gold);}
  .vocab-play.playing .p{border-left-color:var(--navy);}
  .vocab-play.playing .lbl{color:var(--navy);}
  .game-box{background:var(--navy);border:1.5px solid var(--gold);border-radius:14px;padding:18px;position:relative;overflow:hidden;}
  .game-title{font-family:'Poppins',sans-serif;font-weight:700;font-size:14px;color:var(--gold-soft);margin-bottom:4px;}
  .game-sub{font-size:12px;color:#b9c2da;margin-bottom:14px;}
  .match-game{position:relative;display:flex;gap:16px;}
  .match-lines{position:absolute;top:0;left:0;pointer-events:none;}
  .match-col{display:flex;flex-direction:column;gap:8px;flex:1;min-width:0;}
  .match-item{background:var(--cream);color:var(--ink);padding:9px 10px;border-radius:8px;cursor:pointer;text-align:center;font-size:12.5px;font-weight:600;border:2.5px solid transparent;line-height:1.25;user-select:none;transition:background .15s ease;}
  .match-item.selected{border-color:var(--gold);}
  .match-item.correct{background:var(--green-bg);border-color:var(--green);color:#204d29;cursor:default;}
  .match-item.wrong{background:var(--red-bg);}
  .confetti-layer{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;overflow:visible;}
  .confetti-piece{position:absolute;width:6px;height:10px;top:0;opacity:0.95;animation:confettiFall 900ms ease-out forwards;}
  @keyframes confettiFall{0%{transform:translateY(0) rotate(0deg);opacity:1;}100%{transform:translateY(140px) rotate(420deg);opacity:0;}}
  .game-win{display:none;text-align:center;font-family:'Poppins',sans-serif;font-weight:700;color:var(--gold-soft);font-size:14px;margin-top:14px;}
  .game-win.show{display:block;}
  .quiz-progress,.flash-progress{font-size:12px;color:#b9c2da;text-align:center;margin-bottom:12px;}
  .quiz-word{font-family:'Poppins',sans-serif;font-weight:700;font-size:20px;color:var(--cream);text-align:center;margin-bottom:10px;}
  .quiz-play{display:block;margin:0 auto 16px;background:var(--gold);color:var(--navy-deep);border:none;border-radius:20px;padding:8px 18px;font-weight:700;font-size:12.5px;cursor:pointer;}
  .quiz-options{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;}
  .quiz-opt{background:var(--cream);border-radius:10px;padding:10px 4px 8px;cursor:pointer;text-align:center;border:3px solid transparent;display:flex;flex-direction:column;align-items:center;gap:4px;}
  .quiz-opt-emoji{font-size:32px;line-height:1;}
  .quiz-opt-label{font-size:9.5px;font-weight:700;color:var(--navy-soft);text-transform:uppercase;letter-spacing:0.3px;}
  .quiz-opt.correct{background:var(--green-bg);border-color:var(--green);}
  .quiz-opt.wrong{background:var(--red-bg);}
  .quiz-result,.flash-result{text-align:center;margin-top:16px;}
  .quiz-result .tier,.flash-result .tier{font-family:'Poppins',sans-serif;font-weight:700;color:var(--gold-soft);font-size:16px;margin-bottom:10px;}
  .quiz-result button,.flash-result button,.flash-actions button,.flash-rate button{background:var(--gold);color:var(--navy-deep);border:none;border-radius:20px;padding:9px 18px;font-weight:700;font-size:12.5px;cursor:pointer;margin:4px;}
  .flash-card{background:var(--cream);border-radius:14px;padding:26px 18px;text-align:center;min-height:90px;display:flex;flex-direction:column;justify-content:center;gap:8px;}
  .flash-en{font-family:'Poppins',sans-serif;font-weight:700;font-size:18px;color:var(--ink);}
  .flash-pt{font-size:15px;color:var(--navy-soft);border-top:1px dashed #cfc4a4;padding-top:8px;}
  .flash-pt.hidden{display:none;}
  .flash-actions,.flash-rate{text-align:center;margin-top:14px;}
  .flash-rate.hidden,.flash-actions.hidden{display:none;}
  .rate-no{background:#c56b6b !important;color:#fff !important;}
  .rate-yes{background:var(--green) !important;color:#fff !important;}
  .flash-history{margin-top:18px;border-top:1px dashed var(--navy-soft);padding-top:12px;}
  .flash-history-title{font-size:11px;color:var(--gold-soft);font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;}
  .flash-history-row{display:flex;justify-content:space-between;font-size:12.5px;color:#c7cee0;padding:4px 0;}
  .flash-history-row b{color:var(--cream);}
  footer{text-align:center;margin-top:40px;font-size:11.5px;color:#7c86a3;padding:0 20px;}
  footer .brand{color:var(--gold-soft);font-weight:600;}
</style>
</head>
<body>
<div class="topbar">
  <div class="eyebrow">Passaporte de Sobrevivência · Aula 1</div>
  <h1>Comunicação Útil</h1>
  <div class="subtitle">Toque nos botões "🔊 Ouvir" para escutar a pronúncia. Guarde essa página — o Kit de Resgate vale para o curso inteiro.</div>
</div>
<div class="wrap">
  <div class="map-slide">
    <div class="map-cap">📍 Você está aqui: Comunicação Útil</div>
    <div class="map-frame"><svg class="usmap" viewBox="0 0 1000 562" xmlns="http://www.w3.org/2000/svg" id="mapOpen"></svg></div>
  </div>
  <div class="map-note">A cada aula, o viajante avança uma parada na jornada. <b>Próxima parada: Aeroporto.</b></div>

  <div class="mode-bar">
    <span id="modeLabel">Mostrar tradução sempre</span>
    <div class="switch" id="modeSwitch" onclick="toggleMode()"><div class="knob"></div></div>
  </div>

  <div class="section-head"><span class="tag">01</span><h2>Kit de Resgate</h2></div>
  <div class="rescue">
    <div class="rescue-title">🛟 Use em QUALQUER situação, do início ao fim do curso</div>
    <div class="rescue-sub">Começamos por aqui de propósito: são 7 frases que resolvem quase todo perrengue de comunicação. Revisadas para serem realmente úteis nos EUA.</div>
    <div id="rescueCards"></div>
  </div>

  <div class="section-head"><span class="tag">02</span><h2>Vocabulário de viagem</h2></div>
  <div class="section-note">Palavras que você vai ver e ouvir o tempo todo. Só a palavra, pronúncia e tradução.</div>
  <div class="vocab-grid" id="vocabCards"></div>

  <div class="section-head"><span class="tag">03</span><h2>Cumprimentos</h2></div>
  <div class="section-note">Só os cumprimentos mais comuns do dia a dia americano.</div>
  <div id="greetCards"></div>

  <div class="section-head"><span class="tag">04</span><h2>Se apresentar e apresentar a família</h2></div>
  <div class="section-note">Seu nome, e como falar da esposa e dos dois filhos que viajam com você.</div>
  <div id="familyCards"></div>

  <div class="section-head"><span class="tag">05</span><h2>Respondendo "tudo bem?"</h2></div>
  <div class="section-note">Quando perguntarem como você está, é só escolher uma dessas.</div>
  <div id="howareyouCards"></div>

  <div class="section-head"><span class="tag">06</span><h2>De onde você é / Small talk</h2></div>
  <div class="section-note">Perguntas leves de fila, táxi, elevador.</div>
  <div id="stCards"></div>

  <div class="section-head"><span class="tag">07</span><h2>Frases úteis para qualquer situação</h2></div>
  <div class="section-note">Pedir informação, dizer onde está hospedado, quanto tempo vai ficar.</div>
  <div id="usefulCards"></div>

  <div class="section-head"><span class="tag">08</span><h2>Agradecer e se despedir</h2></div>
  <div class="section-note">Fechar qualquer interação com educação.</div>
  <div id="closeCards"></div>

  <div class="section-head"><span class="tag">09</span><h2>Jogo — Conecte os pares</h2></div>
  <div class="game-box">
    <div class="game-title">🎯 Ligue a frase em inglês à tradução certa</div>
    <div class="game-sub">Toque em uma frase da esquerda e depois na tradução correspondente.</div>
    <div class="match-game" id="matchGame">
      <svg class="match-lines" id="matchLines"></svg>
      <div class="confetti-layer" id="confettiLayer"></div>
      <div class="match-col" id="matchLeft"></div>
      <div class="match-col" id="matchRight"></div>
    </div>
    <div class="game-win" id="gameWin">🎉 Muito bem! Você conectou todos os pares!</div>
  </div>

  <div class="section-head"><span class="tag">10</span><h2>Quiz de Vocabulário</h2></div>
  <div class="game-box">
    <div class="quiz-progress">Pergunta <span id="qIdx">1</span>/5 — Acertos: <span id="qScore">0</span></div>
    <div class="quiz-word" id="quizWord"></div>
    <button class="quiz-play" id="quizPlayBtn">🔊 OUVIR A PALAVRA</button>
    <div class="quiz-options" id="quizOptions"></div>
    <div class="quiz-result hidden" id="quizResult"></div>
  </div>

  <div class="map-slide" style="margin-top:36px;">
    <div class="map-cap">✅ Aula concluída — seguindo viagem</div>
    <div class="map-frame"><svg class="usmap" viewBox="0 0 1000 562" xmlns="http://www.w3.org/2000/svg" id="mapClose"></svg></div>
  </div>
  <div class="map-note">Você concluiu <b>Comunicação Útil</b>. Na próxima aula: <b>Aeroporto</b>.</div>
  <footer>Material do curso <span class="brand">Inglês de Viagem</span> — funciona offline depois de salvo no celular.</footer>
</div>

<script>
/* ---------- MAP ---------- */
const stops = [
  {name:"Comunicação útil", icon:"chat", x:80, y:420},{name:"Aeroporto", icon:"plane", x:170, y:290},
  {name:"Imigração", icon:"passport", x:260, y:420},{name:"Transporte", icon:"taxi", x:350, y:280},
  {name:"Hotel", icon:"hotel", x:440, y:420},{name:"Fast food", icon:"food", x:530, y:280},
  {name:"Directions", icon:"pin", x:620, y:420},{name:"Restaurantes", icon:"fork", x:710, y:280},
  {name:"Compras", icon:"bag", x:800, y:420},{name:"Emergências", icon:"cross", x:890, y:280},
  {name:"Revisão", icon:"star", x:950, y:350}
];
const CURRENT = 0;
function iconMarkup(type){
  const c = 'fill="var(--cream)"';
  switch(type){
    case "chat": return '<path d="M-8,-6 h16 a3,3 0 0 1 3,3 v6 a3,3 0 0 1 -3,3 h-9 l-5,4 v-4 h-2 a3,3 0 0 1 -3,-3 v-6 a3,3 0 0 1 3,-3 Z" '+c+'/>';
    case "plane": return '<path d="M-9,3 L1,0 L4,-9 L6,-8 L4,1 L11,-1 L12,1 L5,4 L4,10 L2,9 L3,3 Z" '+c+'/>';
    case "passport": return '<rect x="-6" y="-8" width="12" height="16" rx="1.5" '+c+'/><circle cx="0" cy="-2" r="2.4" fill="var(--navy)"/>';
    case "taxi": return '<rect x="-8" y="-3" width="16" height="7" rx="1.5" '+c+'/><circle cx="-4" cy="5" r="2" '+c+'/><circle cx="4" cy="5" r="2" '+c+'/>';
    case "hotel": return '<rect x="-7" y="-6" width="14" height="12" rx="1" '+c+'/><rect x="-3" y="0" width="6" height="6" fill="var(--navy)"/>';
    case "food": return '<path d="M-6,-6 h12 l-2,12 h-8 z" '+c+'/>';
    case "pin": return '<path d="M0,-8 C5,-8 7,-4 7,0 C7,5 0,9 0,9 C0,9 -7,5 -7,0 C-7,-4 -5,-8 0,-8 Z" '+c+'/>';
    case "fork": return '<rect x="-1.5" y="-8" width="3" height="16" '+c+'/><rect x="-6" y="-8" width="2" height="7" '+c+'/><rect x="4" y="-8" width="2" height="7" '+c+'/>';
    case "bag": return '<rect x="-6" y="-4" width="12" height="10" rx="1" '+c+'/><path d="M-3,-4 v-3 a3,3 0 0 1 6,0 v3" fill="none" stroke="var(--cream)" stroke-width="1.6"/>';
    case "cross": return '<rect x="-2" y="-7" width="4" height="14" rx="1" '+c+'/><rect x="-7" y="-2" width="14" height="4" rx="1" '+c+'/>';
    case "star": return '<path d="M0,-8 L2.3,-2.5 8,-2 3.5,1.7 5,8 0,4.5 -5,8 -3.5,1.7 -8,-2 -2.3,-2.5 Z" '+c+'/>';
    default: return '';
  }
}
function buildMap(svgId, animate){
  const svg = document.getElementById(svgId); const ns = "http://www.w3.org/2000/svg";
  svg.innerHTML = ""; svg.setAttribute("preserveAspectRatio","xMidYMid meet");
  const land = document.createElementNS(ns,"path");
  land.setAttribute("class","land");
  land.setAttribute("d","M60,380 L100,260 L180,190 L300,150 L420,140 L560,150 L680,160 L800,190 L900,240 L950,320 L920,400 L880,460 L780,480 L680,470 L580,490 L480,480 L380,490 L280,470 L180,460 L110,440 Z");
  svg.appendChild(land);
  let d = "M " + stops[0].x + " " + stops[0].y;
  for(let i=1;i<stops.length;i++){ d += " L " + stops[i].x + " " + stops[i].y; }
  const trail = document.createElementNS(ns,"path"); trail.setAttribute("class","trail"); trail.setAttribute("d", d);
  svg.appendChild(trail);
  stops.forEach((s,i)=>{
    const g = document.createElementNS(ns,"g"); g.setAttribute("transform", "translate("+s.x+","+s.y+")");
    const isActive = i === CURRENT && !animate; const isDone = animate && i === CURRENT;
    if(isActive){ const pulse = document.createElementNS(ns,"circle"); pulse.setAttribute("class","pulse"); pulse.setAttribute("cx",0); pulse.setAttribute("cy",0); pulse.setAttribute("r",14); g.appendChild(pulse); }
    const circ = document.createElementNS(ns,"circle"); circ.setAttribute("r",14); circ.setAttribute("class","stop-circle"+(isActive?" active":isDone?" done":"")); g.appendChild(circ);
    const iconG = document.createElementNS(ns,"g"); iconG.innerHTML = iconMarkup(s.icon);
    if(isActive){ iconG.querySelectorAll('[fill="var(--cream)"]').forEach(el=>el.setAttribute('fill','var(--navy-deep)')); }
    g.appendChild(iconG);
    const label = document.createElementNS(ns,"text"); label.setAttribute("class","stop-label"+(isActive?" active":"")); label.setAttribute("text-anchor","middle"); label.setAttribute("y",30);
    label.textContent = (i+1)+". "+s.name; g.appendChild(label);
    svg.appendChild(g);
  });
  const start = stops[CURRENT]; const end = animate ? stops[Math.min(CURRENT+1, stops.length-1)] : stops[CURRENT];
