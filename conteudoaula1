/* ---------- VOCAB QUIZ ---------- */
const quizVocab = [
  {en:"Passport", pt:"Passaporte", emoji:"📘"},
  {en:"Flight", pt:"Voo", emoji:"✈️"},
  {en:"Boarding pass", pt:"Cartão de embarque", emoji:"🎫"},
  {en:"Check-in", pt:"Check-in", emoji:"🖥️"},
  {en:"Luggage / Bags", pt:"Malas", emoji:"🧳"}
];
let quizQueue = [], quizIdx = 0, quizScore = 0;
function startQuiz(){
  quizQueue = shuffle(quizVocab); quizIdx = 0; quizScore = 0;
  document.getElementById('quizResult').classList.add('hidden');
  document.getElementById('quizWord').style.display = 'block';
  document.getElementById('quizPlayBtn').style.display = 'block';
  document.getElementById('quizOptions').style.display = 'grid';
  showQuizQuestion();
}
function showQuizQuestion(){
  document.getElementById('qIdx').textContent = quizIdx+1;
  document.getElementById('qScore').textContent = quizScore;
  const current = quizQueue[quizIdx];
  document.getElementById('quizWord').textContent = current.en;
  document.getElementById('quizPlayBtn').onclick = ()=>speak(current.en, null);
  const others = shuffle(quizVocab.filter(v=>v.en!==current.en)).slice(0,2);
  const opts = shuffle([current, ...others]);
  const optBox = document.getElementById('quizOptions'); optBox.innerHTML = '';
  opts.forEach(opt=>{
    const b = document.createElement('div'); b.className = 'quiz-opt';
    b.innerHTML = `<div class="quiz-opt-emoji">${opt.emoji}</div><div class="quiz-opt-label">${opt.pt}</div>`;
    b.dataset.en = opt.en;
    b.onclick = ()=>checkQuiz(opt, current, b);
    optBox.appendChild(b);
  });
}
function checkQuiz(opt, current, btnEl){
  if(document.getElementById('quizOptions').classList.contains('locked')) return;
  document.getElementById('quizOptions').classList.add('locked');
  const allBtns = document.querySelectorAll('.quiz-opt');
  const correct = opt.en === current.en;
  if(correct){ btnEl.classList.add('correct'); quizScore++; playSuccessSound(); }
  else {
    btnEl.classList.add('wrong'); playErrorSound();
    allBtns.forEach(b=>{ if(b.dataset.en === current.en) b.classList.add('correct'); });
  }
  setTimeout(()=>{
    document.getElementById('quizOptions').classList.remove('locked');
    quizIdx++;
    if(quizIdx < quizQueue.length) showQuizQuestion(); else finishQuiz();
  }, 900);
}
function finishQuiz(){
  document.getElementById('quizWord').style.display='none';
  document.getElementById('quizPlayBtn').style.display='none';
  document.getElementById('quizOptions').style.display='none';
  const total = quizQueue.length;
  const pct = quizScore/total;
  const tier = pct>=0.9 ? '🏆 Excelente!' : pct>=0.7 ? '👍 Muito bom!' : '💪 Continue praticando!';
  const box = document.getElementById('quizResult');
  box.innerHTML = `<div class="tier">${tier}</div><div style="color:#c7cee0;margin-bottom:10px;">Você acertou ${quizScore} de ${total}.</div><button onclick="startQuiz()">🔄 Jogar novamente</button>`;
  box.classList.remove('hidden');
}
startQuiz();
